<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="40dp"
    android:background="#FFFFFF">


    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Sign In"
        android:textSize="24sp"
        android:fontFamily="@font/overpass_bold"
        android:layout_marginTop="65dp"
        android:layout_marginBottom="100dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/overpass_medium"
        android:textSize="16sp"
        android:layout_marginTop="80dp"
        android:textColor="@color/black"
        android:text="Email Address"
        app:layout_constraintTop_toBottomOf="@+id/title"/>

    <!-- Email Input Field with TextInputLayout for error state -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/emailInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#D3D3D3"
        app:boxCornerRadiusTopStart="15dp"
        app:boxCornerRadiusTopEnd="15dp"
        app:boxCornerRadiusBottomStart="15dp"
        app:boxCornerRadiusBottomEnd="15dp"
        app:layout_constraintTop_toBottomOf ="@+id/subtitle"
        android:layout_marginTop="7dp"
        android:hint="Enter email address">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/overpass_regular"
            android:inputType="textEmailAddress"
            android:padding="15dp"
            android:textColorHint="@color/gray"
            android:backgroundTint="@android:color/transparent" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Continue Button -->
    <Button
        android:id="@+id/continueButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Continue"
        android:textSize="16dp"
        android:background="@drawable/sign_in_bt_bacground"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/overpass_bold"
        android:textAllCaps="false"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf ="@+id/emailInputLayout"/>

    <!-- Create Account Text -->
    <TextView
        android:id="@+id/createAccountText"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:text="Don't have an account? Create Account"
        android:textSize="15sp"
        android:textColor="@color/gray"
        android:layout_gravity="center"
        android:fontFamily="@font/overpass_regular"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf ="@+id/continueButton"/>

</androidx.constraintlayout.widget.ConstraintLayout>