<!-- res/layout/custom_dialog.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="1200dp"
    android:orientation="vertical"
    android:foregroundGravity="bottom"
    android:backgroundTint="@color/white"
    android:background="@color/white"
    android:layout_marginEnd="10dp"
    android:padding="24dp">

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Background Location Permission"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <!-- Dialog Message -->
    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To continue tracking your location while the app is running in the background, you need to grant background location permission."
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="16dp" />

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="40dp">

        <!-- Positive Button (Allow) -->
        <Button
            android:id="@+id/btn_positive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow"
            android:textColor="@color/white"
            android:background="@drawable/bt_yes"
            android:padding="8dp"
            android:layout_marginHorizontal="16dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="10dp">

        <!-- Negative Button (Deny) -->
        <Button
            android:id="@+id/btn_negative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deny"
            android:textColor="@color/light_orange"
            android:background="@drawable/bt_no"
            android:padding="8dp"
            android:layout_marginHorizontal="16dp"/>


    </LinearLayout>
</LinearLayout>
