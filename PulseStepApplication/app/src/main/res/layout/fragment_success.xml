<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/inter_semi_bold"
        android:layout_marginTop="50dp"
        android:text="Successful"
        android:textColor="@color/black"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/inter_medium"
        android:layout_marginTop="10dp"
        android:text="@string/successfully_reset_password"
        android:textSize="16sp"
        android:textColor="@color/gray"
        app:layout_constraintTop_toBottomOf="@+id/title"/>

    <ImageView
        android:id="@+id/ic_successfully_reset_password"
        android:layout_width="match_parent"
        android:layout_marginTop="50dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_successfully_reset_password"
        app:layout_constraintTop_toBottomOf="@+id/context"/>


    <!-- Update Button -->
    <Button
        android:id="@+id/bt_continue"
        android:layout_width="327dp"
        android:layout_height="48dp"
        android:background="@drawable/bt_finish"
        android:text="Continue"
        android:layout_marginTop="50dp"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:fontFamily="@font/inter_bold"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ic_successfully_reset_password"/>


</androidx.constraintlayout.widget.ConstraintLayout>