<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white">

    <androidx.cardview.widget.CardView
        android:layout_width="391dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:backgroundTint="@color/lighter_orange">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="55dp">

            <TextView
                android:id="@+id/rank_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01."
                android:textSize="14sp"
                android:fontFamily="@font/inter_semi_bold"
                android:textColor="@color/gray"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>


            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/rank_user_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                tools:src="@tools:sample/avatars"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toEndOf="@id/rank_num"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/rank_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budi Santoso"
                android:textSize="16sp"
                android:fontFamily="@font/inter_semi_bold"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/rank_user_image"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/rank_workout_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12.5hours"
                android:textSize="14sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/gray"
                app:layout_constraintEnd_toStartOf="@id/rank_like"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <CheckBox
                android:id="@+id/rank_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/sl_like"
                app:buttonTint="@color/like_orange"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>