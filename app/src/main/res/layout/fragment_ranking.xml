<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RankingFragment">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/rank_progress"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/orange">

            <TextView
                android:id="@+id/rank_title"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:gravity="center"
                android:text="@string/rank_title"
                android:textColor="@color/white"
                android:textSize="50sp"
                android:fontFamily="@font/inter_extra_bold_italic"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/rank_progress"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="@color/light_orange"
        app:layout_constraintBottom_toTopOf="@id/rank_you">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/progress_orange">

            <TextView
                android:id="@+id/progress_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_title"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_semi_bold"
                android:textSize="15sp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/target_title"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/target_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/target_title"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toBottomOf="@id/progress_title"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/progress_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7.1/"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:fontFamily="@font/inter_bold"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/daily_target_hours"/>

            <TextView
                android:id="@+id/daily_target_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 hours"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:fontFamily="@font/inter_bold"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/bt_set_target"/>

            <ImageView
                android:id="@+id/bt_set_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_edit_24"
                android:layout_marginEnd="15dp"
                app:layout_constraintTop_toTopOf="@id/progress_detail"
                app:layout_constraintBottom_toBottomOf="@id/progress_detail"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:progressDrawable="@drawable/progress_bar"
                android:max="100"
                android:progress="71"
                app:layout_constraintTop_toBottomOf="@id/target_title"
                app:layout_constraintStart_toStartOf="parent"/>  <!-- 当前进度设为 71% -->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/rank_you"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        app:layout_constraintBottom_toTopOf="@id/ranking_List">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/light_orange"
            >

            <TextView
                android:id="@+id/you"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semi_bold"
                android:textColor="@color/gray"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/you_image"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/you_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                tools:src="@tools:sample/avatars"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/you"
                app:layout_constraintEnd_toStartOf="@id/you_name"/>

            <TextView
                android:id="@+id/you_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Heizi"
                android:textSize="16sp"
                android:fontFamily="@font/inter_semi_bold"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/you_image"/>

            <TextView
                android:id="@+id/you_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/inter_medium"
                android:text="7.1 hours"
                android:textColor="@color/gray"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.47" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ranking_List"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>